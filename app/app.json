{
  "expo": {
    "name": "Arclet",
    "slug": "arclet",
    "scheme": "arclet",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/brand/arclet-icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#EEF5FB",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.arclet.wallet",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Arclet uses Face ID to approve payments."
      }
    },
    "android": {
      "package": "app.arclet.wallet",
      "adaptiveIcon": {
        "backgroundColor": "#112039",
        "foregroundImage": "./assets/brand/arclet-adaptive-foreground.png",
        "monochromeImage": "./assets/brand/arclet-monochrome.png"
      },
      "permissions": [
        "android.permission.NFC",
        "android.permission.USE_BIOMETRIC"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/brand/arclet-favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Arclet uses Face ID to unlock your wallet."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Arclet uses Face ID to approve payments."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Arclet uses the camera to scan payment QR codes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#273A63"
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Arclet reads payment requests when you tap another phone.",
          "selectIdentifiers": [
            "D2760000850101"
          ],
          "includeNdefEntitlement": true
        }
      ],
      "expo-build-properties",
      "./plugins/withNfcLaunch",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EEF5FB",
          "image": "./assets/brand/arclet-mark.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/brand/arclet-mark.png",
            "backgroundColor": "#0C1424"
          }
        }
      ]
    ]
  }
}
